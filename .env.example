# Global environment configuration
APP_NAME=FastAPI Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173

# Gmail OAuth configuration
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/oauth/callback

# OpenAI Configuration for Email Generation
# Required: Your OpenAI API key for generating cover letters
OPENAI_API_KEY=sk-...
# Optional: OpenAI model to use (default: gpt-3.5-turbo)
OPENAI_MODEL=gpt-3.5-turbo
# Optional: Temperature for LLM generation, 0.0-2.0 (default: 0.7)
LLM_TEMPERATURE=0.7
# Optional: Maximum tokens for LLM generation (default: 1500)
LLM_MAX_TOKENS=1500

# Frontend configuration
VITE_API_BASE_URL=http://localhost:8000/api
